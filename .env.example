# ---------------------------------------------------------------------------
# n8n-lead-to-meeting-speed-tracker - environment variables
# Set these on your n8n instance (NOT in the workflow JSON, NOT in git).
# Full reference: docs/CONFIGURATION.md
#
# n8n must be allowed to expose env vars to nodes:  N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# ---------------------------------------------------------------------------

# --- SAFETY -----------------------------------------------------------------
# Keep "true" until you have verified everything. While true: nothing is posted to Slack,
# nothing is written to HubSpot, and no state (alert de-dupe, rotation, trend log) is saved.
# Only the exact words false / 0 / no / off turn it off; anything else (including typos) keeps it ON.
SANDBOX_MODE=true

# --- SLACK ------------------------------------------------------------------
# Incoming webhook URL (treat as a secret)
SLACK_WEBHOOK_URL=

# --- HUBSPOT ----------------------------------------------------------------
# Used only to build clickable record links in Slack messages
HUBSPOT_PORTAL_ID=

# --- SLA --------------------------------------------------------------------
# First-touch target, in BUSINESS minutes
SLA_MINUTES=15
# Send an "at risk" warning when this fraction of the SLA has elapsed (0-1)
SLA_WARN_PCT=0.75
# How far back (calendar hours) the 5-minute monitor looks for leads; 96 covers a long weekend
LOOKBACK_HOURS=96
# Weekly report window (days)
REPORT_LOOKBACK_DAYS=7
# Restart the SLA clock when an existing contact submits a form again
CLOCK_RESTARTS_ON_FORM_SUBMIT=true

# --- BUSINESS HOURS ---------------------------------------------------------
BUSINESS_TIMEZONE=America/New_York
BUSINESS_START=09:00
BUSINESS_END=17:00
# ISO weekdays, 1=Mon ... 7=Sun
BUSINESS_WORKDAYS=1,2,3,4,5
# Local dates (YYYY-MM-DD), comma separated
BUSINESS_HOLIDAYS=2026-11-26,2026-12-25

# --- LEAD FILTERS -----------------------------------------------------------
EXCLUDED_LIFECYCLE_STAGES=customer,evangelist,other
# e.g. your own domain / test domains
EXCLUDED_EMAIL_DOMAINS=

# --- ALERTS -----------------------------------------------------------------
# Max leads listed in one Slack alert (the rest are summarized as "+N more")
ALERT_MAX_LEADS=10

# --- ROUND-ROBIN (workflow 2) ------------------------------------------------
# Single-line JSON. Build it from config/reps.sample.json:  jq -c . config/reps.sample.json
# Rep fields: id (HubSpot owner ID), name, active, maxOpenLeads, ooo:[{from,to}]
REPS_JSON=
# Owner who receives leads when no rep is eligible (leave empty to leave such leads unassigned)
FALLBACK_OWNER_ID=
# hs_lead_status values that count as "open" for capacity checks
OPEN_LEAD_STATUSES=NEW,OPEN,IN_PROGRESS,ATTEMPTED_TO_CONTACT
# Reassign contacts that already have an owner? Default false = never touch existing owners.
REASSIGN_EXISTING_OWNER=false
